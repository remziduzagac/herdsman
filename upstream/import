#!/usr/bin/env bash
# Import a herdr revision into the herdr-import branch, renamed to herdsman.
#
#   upstream/import [--accept-license-change] <ref>    e.g. upstream/import v0.9.4
#
# <ref> is resolved in the plain herdr clone at $UPSTREAM_DIR (default
# ~/Projects/herdr); fetch there first. The revision is exported, renamed by
# upstream/rename, and committed on $IMPORT_BRANCH (default herdr-import) with the
# previous import as its parent. That parent chain is what gives each merge
# into dev a base, so never commit to the branch by hand.
#
# herdr's licence decides whether herdsman may take a revision at all. When a
# licence file or a crate's license field differs from the previous import, the
# import stops and shows what changed. Read it, then rerun with
# --accept-license-change.
#
# Nothing here touches the checkout you run it from. MAINTAINING.md describes
# the merge that follows.
set -euo pipefail

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
accept_license_change=false
args=()
for arg in "$@"; do
    case $arg in
        --accept-license-change) accept_license_change=true ;;
        -*) usage ;;
        *) args+=("$arg") ;;
    esac
done
[ ${#args[@]} -eq 1 ] || usage

ref=${args[0]}
upstream=${UPSTREAM_DIR:-$HOME/Projects/herdr}
branch=${IMPORT_BRANCH:-herdr-import}
here=$(cd "$(dirname "$0")" && pwd)
git_dir=$(git rev-parse --absolute-git-dir)

sha=$(git -C "$upstream" rev-parse --verify --quiet "$ref^{commit}") \
    || { echo "import: $ref is not a commit in $upstream" >&2; exit 1; }
name=$(git -C "$upstream" describe --tags "$sha" 2>/dev/null || git -C "$upstream" rev-parse --short=12 "$sha")

# Licence files anywhere in the tree, vendored code included, and the license
# fields of every crate.
license_files() {
    git -C "$upstream" diff --name-status "$1" "$2" \
        | awk -F'\t' '{ n = split($NF, part, "/"); if (tolower(part[n]) ~ /^(licen[cs]e|copying|notice|unlicense)/) print }'
}
license_fields() {
    { git -C "$upstream" grep -E '^license(-file)?[[:space:]]*=' "$1" -- '*Cargo.toml' || true; } \
        | sed "s/^$1://" | sort
}

previous=$(git log -1 --format=%B "refs/heads/$branch" 2>/dev/null \
    | sed -n 's#^Upstream: https://github.com/herdrdev/herdr/commit/\([0-9a-f]*\)$#\1#p' || true)
if [ -z "$previous" ]; then
    echo "import: no previous import to compare herdr's licence with; read it yourself" >&2
elif ! git -C "$upstream" cat-file -e "$previous^{commit}" 2>/dev/null; then
    echo "import: the previous import, $previous, is not in $upstream; fetch there first" >&2
    exit 1
else
    files=$(license_files "$previous" "$sha")
    fields=$(diff <(license_fields "$previous") <(license_fields "$sha") | grep '^[<>]' || true)
    if [ -n "$files$fields" ]; then
        echo "import: herdr's licensing changed since the previous import (${previous:0:12}):" >&2
        [ -z "$files" ] || printf '%s\n' "$files" | sed 's/^/  /' >&2
        [ -z "$fields" ] || printf '%s\n' "$fields" | sed 's/^</  was:/; s/^>/  now:/' >&2
        if ! $accept_license_change; then
            paths=$(printf '%s\n' "$files" | awk -F'\t' 'NF { printf " %s", $NF }')
            cat >&2 <<EOF

Read the change before taking this revision (MAINTAINING.md, "Licence"):

    git -C $upstream diff ${previous:0:12} ${sha:0:12} --${paths:- '*Cargo.toml'}

then import again with --accept-license-change.
EOF
            exit 1
        fi
        echo "import: accepted with --accept-license-change" >&2
    fi
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Export exactly the tracked files of the revision, nothing from the work tree.
GIT_INDEX_FILE="$tmp/upstream.index" git -C "$upstream" read-tree "$sha"
GIT_INDEX_FILE="$tmp/upstream.index" git -C "$upstream" checkout-index --all --prefix="$tmp/tree/"

# The rename sets the package version to 0.0.0, so read herdr's first.
version=$(sed -n 's/^version = "\(.*\)"/\1/p' "$tmp/tree/Cargo.toml" | head -n1)
"$here/rename" apply "$tmp/tree"

# Build the commit with plumbing so no checkout is involved. --force adds files
# the tree's own .gitignore would skip; the export holds only tracked files.
tree=$(cd "$tmp/tree" && export GIT_DIR="$git_dir" GIT_WORK_TREE="$tmp/tree" \
    GIT_INDEX_FILE="$tmp/import.index" && git add --all --force . && git write-tree)

parent=$(git rev-parse --verify --quiet "refs/heads/$branch" || true)
if [ -n "$parent" ] && [ "$(git rev-parse "$parent^{tree}")" = "$tree" ]; then
    echo "import: $branch already holds herdr $name; nothing to do"
    exit 0
fi

sign=()
[ "$(git config --bool commit.gpgsign || true)" != true ] || sign=(-S)
commit=$(git commit-tree "${sign[@]}" "$tree" ${parent:+-p "$parent"} -F - <<EOF
chore: import herdr $name

Upstream: https://github.com/herdrdev/herdr/commit/$sha
Version: $version
Renamed by: upstream/rename $(git hash-object "$here/rename" | cut -c1-12)
EOF
)
git update-ref -m "import herdr $name" "refs/heads/$branch" "$commit" "${parent:-}"

echo "import: herdr $name is $branch $(git rev-parse --short "$commit")"
[ -z "$parent" ] || git --no-pager diff --shortstat "$parent" "$commit"
cat <<EOF

Next, merge it in its own worktree (MAINTAINING.md has the details):

    scripts/worktree merge-v$version
    cd ~/Projects/worktrees/herdsman/merge-v$version && git merge $branch
EOF
