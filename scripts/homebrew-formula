#!/usr/bin/env python3
"""Print the Homebrew formula for the release that distribution/latest.json describes.

    scripts/homebrew-formula [MANIFEST]   > Formula/herdsman.rb

The formula installs the released binaries for macOS and Linux on arm64 and
x86_64, with the checksums from the manifest. The Release workflow writes it
into the remziduzagac/homebrew-tap repository after each release.
"""

import json
import sys

TARGETS = {
    ("macos", "arm"): "macos-aarch64",
    ("macos", "intel"): "macos-x86_64",
    ("linux", "arm"): "linux-aarch64",
    ("linux", "intel"): "linux-x86_64",
}


def main(argv):
    path = argv[1] if len(argv) > 1 else "distribution/latest.json"
    manifest = json.load(open(path))
    version = manifest["version"]

    def block(system, cpu):
        target = TARGETS[(system, cpu)]
        asset = manifest["assets"][target]
        url = asset["url"] if isinstance(asset, dict) else asset
        return (
            f"    on_{cpu} do\n"
            f'      url "{url}"\n'
            f'      sha256 "{manifest["sha256"][target]}"\n'
            f"    end\n"
        )

    systems = "\n".join(
        f"  on_{system} do\n" + block(system, "arm") + block(system, "intel") + "  end\n"
        for system in ("macos", "linux")
    )
    sys.stdout.write(f"""# Generated by scripts/homebrew-formula in remziduzagac/herdsman for each
# release; edits here are overwritten.
class Herdsman < Formula
  desc "Terminal workspace for running coding agents, with stacked panes"
  homepage "https://github.com/remziduzagac/herdsman"
  version "{version}"
  license "Apache-2.0"

{systems}
  def install
    bin.install Dir["herdsman-*"].first => "herdsman"
  end

  test do
    assert_match version.to_s, shell_output("#{{bin}}/herdsman --version")
  end
end
""")


if __name__ == "__main__":
    main(sys.argv)
